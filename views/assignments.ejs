<%- include('partials/header', { active: 'assignments' }) %>

<h1>Assignments
  <span class="subtitle">Who teaches what, to which class, how often</span>
</h1>

<% if (error) { %><div class="msg error"><%= error %></div><% } %>

<div class="card">
  <div class="card-header"><h2>Add an assignment</h2></div>
  <p class="section-intro">Tick more than one class to create a combined period (e.g. two sections merged for Sports or Assembly).</p>

  <% if (teachers.length === 0 || subjects.length === 0 || classes.length === 0) { %>
    <p class="empty-state">Add at least one teacher, subject, and class in <a href="/setup">Setup</a> first.</p>
  <% } else { %>
    <form method="POST" action="/assignments">
      <div class="form-row">
        <select name="teacher_id" required>
          <option value="">Teacher</option>
          <% teachers.forEach(function(t) { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
        </select>
        <select name="subject_id" required>
          <option value="">Subject</option>
          <% subjects.forEach(function(s) { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
        <input type="number" name="periods_per_week" placeholder="Periods/week" min="1" max="40" required style="width:130px">
        <select name="room_id">
          <option value="">No room</option>
          <% rooms.forEach(function(r) { %><option value="<%= r.id %>"><%= r.name %></option><% }) %>
        </select>
        <input type="number" name="max_per_day" placeholder="Max/day (optional)" min="1" max="12" style="width:150px">
      </div>
      <div style="margin-top:12px">
        <label>Classes</label>
        <div class="checkbox-group">
          <% classes.forEach(function(c) { %>
            <label class="checkbox-pill">
              <input type="checkbox" name="class_ids" value="<%= c.id %>"> <%= c.name %>
            </label>
          <% }) %>
        </div>
      </div>
      <div style="margin-top:14px"><button type="submit">Add Assignment</button></div>
    </form>
  <% } %>
</div>

<div class="card">
  <div class="card-header"><h2>Current assignments</h2></div>
  <% if (assignments.length === 0) { %>
    <p class="empty-state">No assignments yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <tr><th>Teacher</th><th>Subject</th><th>Class(es)</th><th>Periods/wk</th><th>Room</th><th>Max/day</th><th></th></tr>
        <% assignments.forEach(function(a) { %>
          <tr>
            <td><%= a.teacher_name %></td>
            <td><%= a.subject_name %></td>
            <td><%= a.class_names %></td>
            <td><%= a.periods_per_week %></td>
            <td><%= a.room_name || 'None' %></td>
            <td><%= a.max_per_day || 'None' %></td>
            <td>
              <form method="POST" action="/assignments/<%= a.id %>/delete" onsubmit="return confirm('Delete this assignment?')">
                <button type="submit" class="danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-header"><h2>Fixed periods</h2></div>
  <p class="section-intro">Pin an assignment to an exact day and period before generating. The scheduler never moves a locked slot, and it still counts toward that assignment's periods/week.</p>

  <% if (lockableAssignments.length === 0) { %>
    <p class="empty-state">Add an assignment above first.</p>
  <% } else { %>
    <form class="form-row" method="POST" action="/assignments/lock">
      <select name="assignment_id" required>
        <option value="">Assignment</option>
        <% lockableAssignments.forEach(function(a) { %>
          <option value="<%= a.id %>"><%= a.teacher_name %> / <%= a.subject_name %> / <%= a.class_names %></option>
        <% }) %>
      </select>
      <select name="day" required>
        <option value="">Day</option>
        <% settings.days.forEach(function(day, i) { %><option value="<%= i %>"><%= day %></option><% }) %>
      </select>
      <select name="period" required>
        <option value="">Period</option>
        <% for (let p = 0; p < settings.periods_per_day; p++) { %><option value="<%= p %>">P<%= p + 1 %></option><% } %>
      </select>
      <button type="submit">Lock This Slot</button>
    </form>
  <% } %>

  <% if (lockedSlots.length > 0) { %>
    <div class="table-wrap" style="margin-top:16px">
      <table>
        <tr><th>Teacher</th><th>Subject</th><th>Class(es)</th><th>Day</th><th>Period</th><th></th></tr>
        <% lockedSlots.forEach(function(l) { %>
          <tr>
            <td><%= l.teacher_name %></td>
            <td><%= l.subject_name %></td>
            <td><%= l.class_names %></td>
            <td><%= l.day_name %></td>
            <td><%= l.period_label %></td>
            <td>
              <form method="POST" action="/assignments/lock/<%= l.assignment_id %>/<%= l.day %>/<%= l.period %>/unlock" onsubmit="return confirm('Unlock this slot?')">
                <button type="submit" class="danger">Unlock</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

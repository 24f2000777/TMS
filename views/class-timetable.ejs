<%- include('partials/header') %>

<h1><%= cls.name %>
  <span class="subtitle">Weekly timetable</span>
</h1>

<% if (error) { %><div class="msg error"><%= error %></div><% } %>

<div class="form-row no-print" style="margin-bottom:16px">
  <button class="secondary" onclick="window.print()">Print</button>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="grid-table">
      <tr>
        <th>Day</th>
        <% for (let p = 0; p < settings.periods_per_day; p++) { %>
          <th class="<%= settings.break_periods.includes(p) ? 'break-cell' : '' %>">P<%= p + 1 %></th>
        <% } %>
      </tr>
      <% for (let d = 0; d < settings.days.length; d++) { %>
        <tr>
          <td><strong><%= settings.days[d] %></strong></td>
          <% for (let p = 0; p < settings.periods_per_day; p++) {
               const cell = grid[d][p];
               const isBreak = settings.break_periods.includes(p);
          %>
            <% if (isBreak) { %>
              <td class="break-cell">Break</td>
            <% } else if (cell) { %>
              <td>
                <span class="cell-subject"><%= cell.subject %></span>
                <span class="cell-meta"><%= cell.teacher %></span>
                <% if (cell.room) { %><span class="cell-meta"><%= cell.room %></span><% } %>
                <% if (cell.combinedWith && cell.combinedWith.length) { %>
                  <span class="badge badge-combined">with <%= cell.combinedWith.join(', ') %></span>
                <% } %>
                <% if (cell.locked) { %><span class="badge badge-locked">Fixed</span><% } %>
                <a class="cell-edit-link no-print" href="/timetable/class/<%= cls.id %>/edit/<%= d %>/<%= p %>">Edit</a>
              </td>
            <% } else { %>
              <td class="empty">
                Free
                <a class="cell-edit-link no-print" href="/timetable/class/<%= cls.id %>/edit/<%= d %>/<%= p %>">Assign</a>
              </td>
            <% } %>
          <% } %>
        </tr>
      <% } %>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
